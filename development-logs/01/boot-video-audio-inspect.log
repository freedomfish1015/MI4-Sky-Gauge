[Unit]
Description=Mi4 internal speaker audio bring-up
After=systemd-modules-load.service
Before=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/mi4-audio-init.sh

[Install]
WantedBy=multi-user.target
RuntimePath=/run/user/1000
State=active
Linger=no
