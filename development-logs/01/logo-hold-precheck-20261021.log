# ]8;;file://umeko-cancro/etc/systemd/system/obd-boot-curtain.service/etc/systemd/system/obd-boot-curtain.service]8;;
[Unit]
Description=Early native NERV boot curtain (rootfs only)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target obd-gauge-kiosk.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/usr/local/share/obd-gauge/startup-1080.argb

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/obd-gauge/boot_curtain.py /usr/local/share/obd-gauge/startup-1080.argb
RemainAfterExit=yes
TimeoutStartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target

# ]8;;file://umeko-cancro/etc/systemd/system/obd-boot-curtain.service.d/90-direct-quiet.conf/etc/systemd/system/obd-boot-curtain.service.d/90-direct-quiet.conf]8;;
[Unit]
Description=Keep Sky Gauge splash and suppress rootfs console text
ConditionPathExists=

[Service]
ExecStart=
ExecStart=/usr/bin/python3 /usr/local/lib/obd-gauge/quiet_boot_direct.py

