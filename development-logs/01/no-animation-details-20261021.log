set -euo pipefail
if systemctl is-active --quiet obd-gauge-kiosk.service && /usr/bin/python3 -c 'import json; from pathlib import Path; s=json.loads(Path("/run/obd-gauge/boot-video.done").read_text()); assert s.get("status")=="complete" and s.get("complete") is True'; then
