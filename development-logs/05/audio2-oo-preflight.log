# /etc/systemd/system/mi4-audio-init.service
[Unit]
Description=Mi4 internal speaker audio bring-up
After=systemd-modules-load.service
Before=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/mi4-audio-init.sh

[Install]
WantedBy=multi-user.target
