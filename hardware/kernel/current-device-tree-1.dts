			opp-table {
				compatible = "operating-points-v2";
				phandle = <0xb7>;

				opp-320000000 {
					opp-hz = <0x00 0x1312d000>;
				};

				opp-200000000 {
					opp-hz = <0x00 0xbebc200>;
				};

				opp-27000000 {
					opp-hz = <0x00 0x19bfcc0>;
				};
			};
		};

		sram@fdd00000 {
			compatible = "qcom,msm8974-ocmem";
			reg = <0xfdd00000 0x2000 0xfec00000 0x180000>;
			reg-names = "ctrl\0mem";
			ranges = <0x00 0xfec00000 0x180000>;
			clocks = <0x46 0x22 0x63 0x74>;
			clock-names = "core\0iface";
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			gmu-sram@0 {
				reg = <0x00 0x100000>;
				phandle = <0xb6>;
			};
		};

		remoteproc@fe200000 {
			compatible = "qcom,msm8974-adsp-pil";
			reg = <0xfe200000 0x100>;
			interrupts-extended = <0x01 0x00 0xa2 0x01 0xb9 0x00 0x01 0xb9 0x01 0x01 0xb9 0x02 0x01 0xb9 0x03 0x01>;
			interrupt-names = "wdog\0fatal\0ready\0handover\0stop-ack";
			clocks = <0x13>;
			clock-names = "xo";
			power-domains = <0x42 0x00>;
			power-domain-names = "cx";
			memory-region = <0xba>;
			qcom,smem-states = <0xbb 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";

			smd-edge {
				interrupts = <0x00 0x9c 0x01>;
				mboxes = <0x12 0x08>;
				qcom,smd-edge = <0x01>;
				label = "lpass";

				apr {
					#size-cells = <0x00>;
					#address-cells = <0x01>;
					qcom,domain = <0x04>;
					qcom,smd-channels = "apr_audio_svc";
					compatible = "qcom,apr-v2";

					service@8 {
						reg = <0x08>;
						compatible = "qcom,q6adm";

						routing {
							phandle = <0xc4>;
							#sound-dai-cells = <0x00>;
							compatible = "qcom,q6adm-routing";
						};
					};

					service@7 {
						reg = <0x07>;
						compatible = "qcom,q6asm";

						dais {
							phandle = <0xc2>;
							#sound-dai-cells = <0x01>;
							#size-cells = <0x00>;
							#address-cells = <0x01>;
							compatible = "qcom,q6asm-dais";

							dai@0 {
								direction = <0x02>;
								reg = <0x00>;
							};
						};
					};

					service@4 {
						reg = <0x04>;
						compatible = "qcom,q6afe";

						dais {
							phandle = <0xc3>;
							#sound-dai-cells = <0x01>;
							#size-cells = <0x00>;
							#address-cells = <0x01>;
							compatible = "qcom,q6afe-dais";

							dai@2 {
								reg = <0x02>;
							};
						};
					};

					service@3 {
						reg = <0x03>;
						compatible = "qcom,q6core";
					};
				};
			};
		};

		sram@fe805000 {
			compatible = "qcom,msm8974-imem\0syscon\0simple-mfd";
			reg = <0xfe805000 0x1000>;

			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x65c>;
			};
		};
	};

	thermal-zones {

		cpu0-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0xbc 0x05>;

			trips {

				trip0 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};

		cpu1-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
