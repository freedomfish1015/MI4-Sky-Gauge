/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;
	model = "Xiaomi Mi4(cancro)";
	compatible = "xiaomi,cancro\0qcom,msm8974pro\0qcom,msm8974";
	chassis-type = "handset";
	qcom,msm-id = <0xc2 0x10000>;
	qcom,board-id = <0x08 0x00>;

	__symbols__ {
		mi4_taiko = "/soc/slim-ngd@fe12f000/ngd@1/codec@1,0";
		mi4_slimbam = "/soc/dma-controller@fe104000";
		mi4_q6routing = "/soc/remoteproc@fe200000/smd-edge/apr/service@8/routing";
		mi4_q6asm = "/soc/remoteproc@fe200000/smd-edge/apr/service@7/dais";
		mi4_q6afe = "/soc/remoteproc@fe200000/smd-edge/apr/service@4/dais";
		mi4_audio_l1 = "/remoteproc/smd-edge/rpm-requests/regulators-1/l1/";
	};

	sound {
		status = "disabled";
		model = "Mi4-Taiko";
		compatible = "xiaomi,cancro-taiko-sndcard";

		slim-dai-link {
			link-name = "SLIMBUS_0_RX";

			codec {
				sound-dai = <0xc5>;
			};

			platform {
				sound-dai = <0xc4>;
			};

			cpu {
				sound-dai = <0xc3 0x02>;
			};
		};

		mm1-dai-link {
			link-name = "MultiMedia1 Playback";

			cpu {
				sound-dai = <0xc2 0x00>;
			};
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	clocks {

		xo_board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			phandle = <0x13>;
		};

		sleep_clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			phandle = <0x1d>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		interrupts = <0x01 0x09 0xf04>;

		cpu@0 {
			compatible = "qcom,krait";
			enable-method = "qcom,kpss-acc-v2";
			device_type = "cpu";
			reg = <0x00>;
			next-level-cache = <0x02>;
			qcom,acc = <0x03>;
			qcom,saw = <0x04>;
			cpu-idle-states = <0x05>;
			phandle = <0x56>;
		};

		cpu@1 {
			compatible = "qcom,krait";
			enable-method = "qcom,kpss-acc-v2";
			device_type = "cpu";
			reg = <0x01>;
			next-level-cache = <0x02>;
			qcom,acc = <0x06>;
			qcom,saw = <0x07>;
			cpu-idle-states = <0x05>;
			phandle = <0x58>;
		};

		cpu@2 {
			compatible = "qcom,krait";
			enable-method = "qcom,kpss-acc-v2";
			device_type = "cpu";
			reg = <0x02>;
			next-level-cache = <0x02>;
			qcom,acc = <0x08>;
			qcom,saw = <0x09>;
			cpu-idle-states = <0x05>;
			phandle = <0x5a>;
		};

		cpu@3 {
			compatible = "qcom,krait";
			enable-method = "qcom,kpss-acc-v2";
			device_type = "cpu";
			reg = <0x03>;
			next-level-cache = <0x02>;
			qcom,acc = <0x0a>;
			qcom,saw = <0x0b>;
			cpu-idle-states = <0x05>;
			phandle = <0x5c>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			qcom,saw = <0x0c>;
			phandle = <0x02>;
		};

		idle-states {

			cpu-spc {
				compatible = "qcom,idle-state-spc\0arm,idle-state";
				entry-latency-us = <0x96>;
				exit-latency-us = <0xc8>;
				min-residency-us = <0x7d0>;
				phandle = <0x05>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-msm8974\0qcom,scm";
			clocks = <0x0d 0x8e 0x0d 0x8d 0x0d 0x8c>;
			clock-names = "core\0bus\0iface";
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00>;
	};

	pmu {
		compatible = "qcom,krait-pmu";
		interrupts = <0x01 0x07 0xf04>;
	};

	remoteproc {
		compatible = "qcom,msm8974-rpm-proc\0qcom,rpm-proc";

		master-stats {
			compatible = "qcom,rpm-master-stats";
			qcom,rpm-msg-ram = <0x0e 0x0f 0x10 0x11>;
			qcom,master-names = "APSS\0MPSS\0LPSS\0PRONTO";
		};

		smd-edge {
			interrupts = <0x00 0xa8 0x01>;
			mboxes = <0x12 0x00>;
			qcom,smd-edge = <0x0f>;

			rpm-requests {
				compatible = "qcom,rpm-msm8974\0qcom,smd-rpm";
				qcom,smd-channels = "rpm_requests";

				clock-controller {
					compatible = "qcom,rpmcc-msm8974\0qcom,rpmcc";
					#clock-cells = <0x01>;
					clocks = <0x13>;
					clock-names = "xo";
					phandle = <0x46>;
				};

				power-controller {
					compatible = "qcom,msm8974-rpmpd";
					#power-domain-cells = <0x01>;
					operating-points-v2 = <0x14>;
					phandle = <0x42>;

					opp-table {
						compatible = "operating-points-v2";
						phandle = <0x14>;

						opp1 {
							opp-level = <0x01>;
						};

						opp2 {
							opp-level = <0x02>;
						};

						opp3 {
							opp-level = <0x03>;
						};

						opp4 {
							opp-level = <0x04>;
						};

						opp5 {
							opp-level = <0x05>;
						};

						opp6 {
							opp-level = <0x06>;
						};
					};
				};

				regulators-0 {
					compatible = "qcom,rpm-pm8841-regulators";

					s1 {
						regulator-min-microvolt = <0xa4cb8>;
						regulator-max-microvolt = <0x100590>;
						phandle = <0x44>;
					};

					s2 {
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x100590>;
						status = "okay";
					};

					s3 {
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x100590>;
						phandle = <0x9f>;
					};
				};

				regulators-1 {
					compatible = "qcom,rpm-pm8941-regulators";
					vdd_l1_l3-supply = <0x15>;
					vdd_l2_lvs1_2_3-supply = <0x16>;
					vdd_l4_l11-supply = <0x15>;
					vdd_l5_l7-supply = <0x17>;
					vdd_l6_l12_l14_l15-supply = <0x17>;
					vdd_l8_l16_l18_l19-supply = <0x18>;
					vdd_l9_l10_l17_l22-supply = <0x19>;
					vdd_l13_l20_l23_l24-supply = <0x19>;
					vdd_l21-supply = <0x19>;

					s1 {
						regulator-min-microvolt = <0x137478>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x15>;
					};

					s2 {
						regulator-min-microvolt = <0x20ce70>;
						regulator-max-microvolt = <0x20ce70>;
						regulator-boot-on;
						phandle = <0x17>;
					};

					s3 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-system-load = <0x25990>;
						regulator-always-on;
						regulator-boot-on;
						regulator-allow-set-load;
						phandle = <0x16>;
					};

					l1 {
						phandle = <0xc1>;
						regulator-min-microvolt = <0x12b128>;
						regulator-max-microvolt = <0x12b128>;
						regulator-always-on;
						regulator-boot-on;
					};

					l2 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
						regulator-boot-on;
						phandle = <0xac>;
					};

					l3 {
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x12b128>;
						regulator-boot-on;
					};

					l4 {
						regulator-min-microvolt = <0x12b128>;
						regulator-max-microvolt = <0x12b128>;
					};

					l5 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l6 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-boot-on;
						phandle = <0x3e>;
					};

					l7 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-boot-on;
					};

					l8 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l9 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2d0370>;
					};

					l10 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2d0370>;
					};

					l11 {
						regulator-min-microvolt = <0x12b128>;
						regulator-max-microvolt = <0x149970>;
						phandle = <0x47>;
					};

					l12 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-always-on;
						regulator-boot-on;
						regulator-allow-set-load;
						phandle = <0xa0>;
					};

					l13 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-boot-on;
					};

					l14 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l15 {
						regulator-min-microvolt = <0x1f47d0>;
						regulator-max-microvolt = <0x1f47d0>;
					};

					l16 {
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x2932e0>;
					};

					l17 {
						regulator-min-microvolt = <0x2b7cd0>;
						regulator-max-microvolt = <0x2d0370>;
					};

					l18 {
						regulator-min-microvolt = <0x2b7cd0>;
						regulator-max-microvolt = <0x2b7cd0>;
						regulator-always-on;
					};

					l19 {
						regulator-min-microvolt = <0x2c4020>;
						regulator-max-microvolt = <0x331df0>;
						phandle = <0x48>;
					};

					l20 {
						regulator-min-microvolt = <0x2d0370>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-system-load = <0x30d40>;
						regulator-allow-set-load;
						regulator-boot-on;
						phandle = <0x1e>;
					};

					l21 {
						regulator-min-microvolt = <0x2d0370>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-boot-on;
					};

					l22 {
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x2dc6c0>;
						regulator-allow-set-load;
						regulator-always-on;
						phandle = <0xad>;
					};

					l23 {
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x2dc6c0>;
					};

					l24 {
						regulator-min-microvolt = <0x2eebb8>;
						regulator-max-microvolt = <0x2eebb8>;
						phandle = <0x3f>;
					};

					lvs3 {
					};
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		mpss@8000000 {
			reg = <0x8000000 0x5100000>;
			no-map;
			phandle = <0xa2>;
		};

		mba@d100000 {
			reg = <0xd100000 0x100000>;
			no-map;
			phandle = <0xa1>;
		};

		wcnss@d200000 {
			reg = <0xd200000 0xa00000>;
			no-map;
			phandle = <0x40>;
		};

		adsp@dc00000 {
			reg = <0xdc00000 0x1900000>;
			no-map;
			phandle = <0xba>;
		};

		memory@f500000 {
			reg = <0xf500000 0x500000>;
			no-map;
		};

		smem@fa00000 {
			reg = <0xfa00000 0x200000>;
			no-map;
			phandle = <0x1a>;
		};

		memory@fc00000 {
			reg = <0xfc00000 0x160000>;
			no-map;
		};

		memory@fd60000 {
			reg = <0xfd60000 0x20000>;
			no-map;
		};

		rmtfs@fd80000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0xfd80000 0x180000>;
			no-map;
			qcom,client-id = <0x01>;
		};
	};

	smem {
		compatible = "qcom,smem";
		memory-region = <0x1a>;
		qcom,rpm-msg-ram = <0x1b>;
		hwlocks = <0x1c 0x03>;
	};

	smp2p-adsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1bb 0x1ad>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x9e 0x01>;
		mboxes = <0x12 0x0a>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xbb>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xb9>;
		};
	};

	smp2p-modem {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x1b 0x01>;
		mboxes = <0x12 0x0e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x9e>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x9d>;
		};
	};

	smp2p-wcnss {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1c3 0x1af>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x8f 0x01>;
		mboxes = <0x12 0x12>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x04>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x43>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x41>;
		};
	};

	smsm {
		compatible = "qcom,smsm";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		mboxes = <0x00 0x12 0x0d 0x12 0x09 0x12 0x13>;

		apps@0 {
			reg = <0x00>;
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x4a>;
		};

		modem@1 {
			reg = <0x01>;
			interrupts = <0x00 0x1a 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xa3>;
		};

		adsp@2 {
			reg = <0x02>;
			interrupts = <0x00 0x9d 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		wcnss@7 {
			reg = <0x07>;
			interrupts = <0x00 0x90 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;
		compatible = "simple-bus";

		slim-ngd@fe12f000 {
			#size-cells = <0x00>;
			#address-cells = <0x01>;
			dma-names = "rx\0tx";
			dmas = <0xc0 0x03 0xc0 0x04>;
			interrupts = <0x00 0xa3 0x04>;
			interrupt-parent = <0x01>;
			reg = <0xfe12f000 0x35000>;
			compatible = "qcom,slim-ngd-v1.5.0";

			ngd@1 {
				#size-cells = <0x00>;
				#address-cells = <0x02>;
				reg = <0x01>;

				codec@1,0 {
					phandle = <0xc5>;
					vddcx-2-supply = <0xc1>;
					vddcx-1-supply = <0xc1>;
					vdd-a-1p2v-supply = <0xc1>;
					vddpx-1-supply = <0x16>;
					vdd-rx-h-supply = <0x16>;
					vdd-tx-h-supply = <0x16>;
					vdd-buck-supply = <0x17>;
					irq-gpios = <0x26 0x48 0x00>;
					interrupts-extended = <0x26 0x48 0x04>;
					reset-gpios = <0x26 0x3f 0x01>;
					#sound-dai-cells = <0x00>;
					reg = <0x01 0x00>;
					compatible = "slim217,a0";
				};

				codec@0,0 {
					reg = <0x00 0x00>;
					compatible = "slim217,a0";
				};
			};
		};

		dma-controller@fe104000 {
			phandle = <0xc0>;
			qcom,num-ees = <0x02>;
			qcom,ee = <0x01>;
			#dma-cells = <0x01>;
			num-channels = <0x1f>;
			interrupts = <0x00 0xa4 0x04>;
			interrupt-parent = <0x01>;
			reg = <0xfe104000 0x20000>;
			qcom,controlled-remotely;
			compatible = "qcom,bam-v1.4.0";
		};

		interrupt-controller@f9000000 {
			compatible = "qcom,msm-qgic2";
			interrupt-controller;
			#interrupt-cells = <0x03>;
			reg = <0xf9000000 0x1000 0xf9002000 0x1000>;
			phandle = <0x01>;
		};

		mailbox@f9011000 {
			compatible = "qcom,msm8974-apcs-kpss-global\0qcom,msm8994-apcs-kpss-global\0syscon";
			reg = <0xf9011000 0x1000>;
			#mbox-cells = <0x01>;
			phandle = <0x12>;
		};

		power-manager@f9012000 {
			compatible = "qcom,msm8974-saw2-v2.1-l2\0qcom,saw2";
			reg = <0xf9012000 0x1000>;
			phandle = <0x0c>;
		};

		watchdog@f9017000 {
			compatible = "qcom,apss-wdt-msm8974\0qcom,kpss-wdt";
			reg = <0xf9017000 0x1000>;
			interrupts = <0x00 0x03 0x01 0x00 0x04 0x01>;
			clocks = <0x1d>;
		};

		timer@f9020000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			compatible = "arm,armv7-timer-mem";
			reg = <0xf9020000 0x1000>;
			clock-frequency = <0x124f800>;

			frame@f9021000 {
				frame-number = <0x00>;
				interrupts = <0x00 0x08 0x04 0x00 0x07 0x04>;
				reg = <0xf9021000 0x1000 0xf9022000 0x1000>;
			};

			frame@f9023000 {
				frame-number = <0x01>;
				interrupts = <0x00 0x09 0x04>;
				reg = <0xf9023000 0x1000>;
				status = "disabled";
			};

			frame@f9024000 {
				frame-number = <0x02>;
				interrupts = <0x00 0x0a 0x04>;
				reg = <0xf9024000 0x1000>;
				status = "disabled";
			};

			frame@f9025000 {
				frame-number = <0x03>;
				interrupts = <0x00 0x0b 0x04>;
				reg = <0xf9025000 0x1000>;
				status = "disabled";
			};

			frame@f9026000 {
				frame-number = <0x04>;
				interrupts = <0x00 0x0c 0x04>;
				reg = <0xf9026000 0x1000>;
				status = "disabled";
			};

			frame@f9027000 {
				frame-number = <0x05>;
				interrupts = <0x00 0x0d 0x04>;
				reg = <0xf9027000 0x1000>;
				status = "disabled";
			};

			frame@f9028000 {
				frame-number = <0x06>;
				interrupts = <0x00 0x0e 0x04>;
				reg = <0xf9028000 0x1000>;
				status = "disabled";
			};
		};

		power-manager@f9088000 {
			compatible = "qcom,kpss-acc-v2";
			reg = <0xf9088000 0x1000 0xf9008000 0x1000>;
			phandle = <0x03>;
